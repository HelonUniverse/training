# PassPro Video Studio — environment variable NAMES. Never commit real values.
# All secrets live server-side only (Supabase Edge Function secrets / Railway
# variables). Nothing here may be exposed with a NEXT_PUBLIC_/VITE_/EXPO_PUBLIC_ prefix.

# ---------------------------------------------------------------- generation (Edge Functions)
# mock = free fake provider (DEFAULT). live = real, paid provider.
VIDEO_PROVIDER_MODE=mock
# Required only when VIDEO_PROVIDER_MODE=live
VIDEO_PROVIDER=
# Must be exactly I_UNDERSTAND_THIS_SPENDS_MONEY to allow live mode.
# The database switch vs_settings.generation.paid_providers_enabled must ALSO be true.
VIDEO_PAID_GENERATION_CONFIRM=

MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io
MINIMAX_VIDEO_MODEL=MiniMax-H3
# random string embedded in the provider callback URL to authenticate webhooks
MINIMAX_CALLBACK_SECRET=

# Script analysis planner (future LLM planner; the rule-based planner needs none)
ANTHROPIC_API_KEY=
PLANNER_MODEL=

# Voice fallback (not needed for the MVP; MiniMax native voices are used first)
VOICE_PROVIDER=
ELEVENLABS_API_KEY=

VIDEO_STUDIO_BUCKET=video-studio

# ---------------------------------------------------------------- render worker (Railway)
# The worker gets ONLY these. It refuses to start if any AI key above is set.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RENDER_POLL_INTERVAL_MS=5000
